---
// Hero object for gesedge.com: the email triage system's board, redrawn in HTML from the live UI.
// Sample messages only; no client data (DESIGN.md §6). The moving dot is the "bridge" accent.
interface Props { caption: string }
const { caption } = Astro.props;
const rows = [
  { id: 'T-1042', subject: 'Re: PO status, 32 open lines', cat: 'Order status', owner: 'Dana', state: 'Due today' },
  { id: 'T-1043', subject: 'Return label for RMA 4471', cat: 'Returns', owner: 'Luis', state: 'On track' },
  { id: 'T-1044', subject: 'Invoice 1188 attached', cat: 'Billing', owner: 'Priya', state: 'Waiting' },
  { id: 'T-1045', subject: 'Can you expedite unit 22?', cat: 'Expedite', owner: 'Dana', state: 'Needs review' },
];
---
<figure class="triage">
  <div class="frame" aria-hidden="true">
    <div class="bar"><span>Shared mailbox</span><span>Tickets</span></div>
    <ol>
      {rows.map((r, i) => (
        <li style={`--i:${i}`}>
          <span class="subj">{r.subject}</span>
          <span class="wire"><i></i></span>
          <span class="ticket">
            <span class="id">{r.id}</span>
            <span class="chip">{r.cat}</span>
            <span class="who">{r.owner}</span>
            <span class="state">{r.state}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
  <figcaption class="label">{caption}</figcaption>
</figure>

<style>
  .triage { margin: 0; }
  .frame { background: var(--panel); border: 1px solid var(--line); font-size: 13px; }
  .bar { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid var(--line);
    color: var(--muted); letter-spacing: 0.12em; text-transform: uppercase; font-size: 11px; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1.15fr); align-items: center; gap: 10px;
    padding: 14px; border-bottom: 1px solid var(--line); }
  li:last-child { border-bottom: 0; }
  .subj { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wire { position: relative; height: 1px; background: var(--line); }
  .wire i { position: absolute; top: -2px; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--celadon);
    opacity: 0; animation: travel 8s calc(var(--i) * 2s) infinite; }
  .ticket { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  .id { color: var(--muted); }
  .chip { color: var(--timber); background: var(--celadon); padding: 1px 7px; border-radius: 3px; }
  .who { color: var(--ink); }
  .state { color: var(--ash); border: 1px solid var(--line); padding: 0 6px; border-radius: 3px; }
  figcaption { margin-top: 10px; }
  @keyframes travel {
    0% { left: 0; opacity: 0; } 3% { opacity: 1; } 18% { left: calc(100% - 5px); opacity: 1; } 22%, 100% { left: calc(100% - 5px); opacity: 0; }
  }
  @media (max-width: 600px) {
    li { grid-template-columns: 1fr; gap: 6px; }
    .wire { display: none; }
  }
</style>
