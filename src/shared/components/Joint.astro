---
// Hero object: the dovetail logo rendered in Blender (.ai/deliverables/logo-anim/joint_anim.py, encode.sh).
// It opens face-on as the flat mark, turns to 3/4, and the tail slides out along its channel and locks back
// in (a dovetail only assembles along its depth). Rendered on black and blended with `lighten`, so the black
// drops out to the page ground exactly.
// Delivery (2026-11-19, preview): an animated AVIF in <picture> instead of <video>. Phones in Low Power Mode, WeChat
// and data-saver modes block video autoplay and show a play control. Animated images are not blocked, and the AVIF
// weighs the same as the video (55 KB at 520 px, 79 KB at 800 px). A browser without AVIF gets the still frame:
// it is the lightest fallback, and every current engine that decodes AVIF also animates it.
// Reduced motion: the first <source> matches, so the AVIF never downloads and the still 3/4 frame shows instead.
// Pause (WCAG 2.2.2): an image has no pause API, so the button swaps the loop for the still frame. Needs JS.
import { SITE } from '../site';
import { t } from '../../zh/copy';
const label = SITE === 'zh' ? { pause: t.pause, play: t.play } : { pause: 'Pause animation', play: 'Play animation' };
---
<div class="joint">
  <picture>
    <source media="(prefers-reduced-motion: reduce)" srcset="/media/joint-still.webp" type="image/webp" />
    <source media="(max-width: 860px)" srcset="/media/joint-520.avif" type="image/avif" />
    <source srcset="/media/joint-800.avif" type="image/avif" />
    <img class="move" src="/media/joint-still.webp" width="800" height="800" alt="" fetchpriority="high" />
  </picture>
  <img class="still" src="/media/joint-still.webp" width="800" height="800" alt="" loading="lazy" decoding="async" />
  <button class="toggle" type="button" hidden aria-label={label.pause} data-pause={label.pause} data-play={label.play}><span aria-hidden="true"></span></button>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.joint')) {
    const button = box.querySelector<HTMLButtonElement>('.toggle')!;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    button.hidden = false;
    const still = box.querySelector<HTMLImageElement>('.still')!;
    button.addEventListener('click', async () => {
      // load and decode the still frame before the swap, so the hero never shows an empty box
      if (!box.classList.contains('paused')) {
        still.loading = 'eager';
        await still.decode().catch(() => {});
      }
      const paused = box.classList.toggle('paused');
      button.classList.toggle('paused', paused);
      button.setAttribute('aria-label', paused ? button.dataset.play! : button.dataset.pause!);
    });
  }
</script>

<style>
  .joint { position: relative; aspect-ratio: 1; }
  .move, .still { display: block; width: 100%; height: auto; }
  .move { mix-blend-mode: lighten; }
  .still { display: none; }
  .joint.paused picture { display: none; }
  .joint.paused .still { display: block; }
  .toggle { position: absolute; right: 4%; bottom: 4%; width: 44px; height: 44px; display: grid; place-items: center;
    background: transparent; border: 1px solid var(--line); border-radius: 50%; color: var(--muted); cursor: pointer; padding: 0; }
  .toggle:hover { color: var(--ink); border-color: var(--muted); }
  .toggle[hidden] { display: none; }
  /* pause glyph: two bars; play glyph: triangle */
  .toggle span { width: 8px; height: 10px; border-left: 2px solid currentColor; border-right: 2px solid currentColor; }
  .toggle.paused span { width: 0; height: 0; border: 0; border-left: 9px solid currentColor;
    border-top: 6px solid transparent; border-bottom: 6px solid transparent; margin-left: 2px; }
</style>
