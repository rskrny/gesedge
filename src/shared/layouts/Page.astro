---
// Page shell for both sites: head (SEO, fonts), header, footer. SITE picks the language and chrome.
import '@fontsource-variable/unbounded/wght.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/base.css';
import Logo from '../components/Logo.astro';
import { SITE, PREVIEW, HOST, CANONICAL, EMAIL, BOOKING, GES, HQ, ZH_LIVE } from '../site';
import { t } from '../../zh/copy';

interface Props {
  title: string;
  description: string;
  path: string; // '/services/'
  alt?: string; // equivalent page on the other site, for hreflang
  noindex?: boolean;
}
const { title, description, path, noindex } = Astro.props;
const alt = ZH_LIVE ? Astro.props.alt : undefined; // no cross-site links until both sites are live
const zh = SITE === 'zh';
const other = zh ? 'en' : 'zh';
const lang = zh ? 'zh-CN' : 'en-US';
const canonical = CANONICAL[SITE] + path;

const nav = zh
  ? [{ href: '/audit/', label: t.nav.audit }, { href: '/sample/', label: t.nav.sample }, { href: '/contact/', label: t.nav.contact }]
  : [{ href: '/services/', label: 'Services' }, { href: '/work/', label: 'Work' }, { href: '/about/', label: 'About' }, { href: '/contact/', label: 'Contact' }];
const switchLink = zh ? { href: HOST.en + (alt ?? '/'), label: 'EN', lang: 'en' } : { href: HOST.zh + (alt ?? '/'), label: '中文', lang: 'zh-CN' };
const here = (href: string) => path.startsWith(href);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alt && <link rel="alternate" hreflang={lang} href={canonical} />}
    {alt && <link rel="alternate" hreflang={zh ? 'en-US' : 'zh-CN'} href={CANONICAL[other] + alt} />}
    {alt && <link rel="alternate" hreflang="x-default" href={zh ? CANONICAL.en + alt : canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${CANONICAL[SITE]}/og-${SITE}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#140e0b" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <!-- ?v=2: the old site served a different icon at /favicon.svg; new URL busts browser favicon caches -->
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style set:html={[400, 500].map((w) => `@font-face{font-family:'Alibaba PuHuiTi 3.0';src:url(/fonts/puhuiti-${SITE}-${w}.woff2) format('woff2');font-weight:${w};font-display:swap}`).join('')} />
    <slot name="head" />
  </head>
  <body>
    {zh && <div hidden><img src="/share.png" width="512" height="512" alt="" /></div>}
    <a class="skip" href="#main">{zh ? t.skip : 'Skip to content'}</a>
    <header class="site-head wrap">
      <a href="/" class="home" aria-label={zh ? HQ.short : GES.name}>
        <Logo variant={zh ? 'huanqiao' : 'ges'} height={26} />
      </a>
      <nav aria-label={zh ? t.nav.label : 'Main'}>
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={here(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          {ZH_LIVE && <li><a href={switchLink.href} hreflang={switchLink.lang} lang={switchLink.lang}>{switchLink.label}</a></li>}
        </ul>
      </nav>
      {zh ? <a class="btn" href="/contact/">{t.cta}</a> : <a class="btn" href={BOOKING}>Book a call</a>}
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot wrap">
      <div class="grid">
        <div class="s-4">
          <Logo variant={zh ? 'chengdu' : 'ges'} height={24} />
        </div>
        <div class="s-4 small">
          <p>{GES.name}, {GES.place}</p>
          <p lang="zh-CN">{HQ.name}<br />{zh ? t.footer.uscc : 'Unified Social Credit Code'} {HQ.uscc}{zh && <><br />{HQ.address}<br />{t.footer.fapiao}</>}</p>
          {zh && <p>{t.footer.sisters}</p>}
        </div>
        <div class="s-4 small">
          <ul class="foot-links">
            {zh
              ? <><li><a href="/privacy/">{t.footer.privacy}</a></li></>
              : <><li><a href="/exporters/">For exporters</a></li><li><a href="/privacy/">Privacy</a></li></>}
            <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-head { display: flex; align-items: center; gap: 40px; min-height: 88px; }
  .site-head .home { display: flex; color: inherit; }
  .site-head nav { margin-left: auto; }
  .site-head ul { display: flex; gap: 30px; list-style: none; margin: 0; padding: 0; }
  .site-head nav a { color: var(--muted); text-decoration: none; font-size: 15px; }
  .site-head nav a:hover, .site-head nav a[aria-current='page'] { color: var(--ink); }
  .site-head .btn { padding: 11px 18px; font-size: 14px; }
  .site-foot { padding-top: 56px; padding-bottom: 56px; border-top: 1px solid var(--line); }
  .small { font-size: 14px; color: var(--muted); }
  .small p { margin-bottom: 0.8em; }
  .foot-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  @media (max-width: 860px) {
    .site-head { flex-wrap: wrap; gap: 14px 16px; min-height: 0; padding-top: 18px; padding-bottom: 18px; }
    .site-head nav { order: 3; width: 100%; margin-left: 0; }
    .site-head ul { gap: 20px; flex-wrap: wrap; }
    .site-head .btn { margin-left: auto; padding: 10px 14px; }
  }
</style>
