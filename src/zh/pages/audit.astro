---
// All text from ../copy.ts. Kimi: registration block high on this page. English equivalent: gesedge.com/exporters/.
import Page from '../../shared/layouts/Page.astro';
import { HQ } from '../../shared/site';
import { t } from '../copy';
const a = t.audit;
---
<Page title={a.title} description={a.description} path="/audit/" alt="/exporters/">
  <div class="wrap head">
    <h1 class="display h1">{a.h1}</h1>
    <p class="muted">{a.lede}</p>
    <p class="reg label">{HQ.name} · {t.footer.uscc} {HQ.uscc} · {t.footer.fapiao}</p>
    <p class="ctas"><a class="btn" href="/contact/">{t.cta}</a></p>
  </div>
  <section><div class="wrap grid"><h2 class="label s-4">{a.getTitle}</h2><ul class="s-8 list">{a.get.map((g) => <li>{g}</li>)}</ul></div></section>
  <section><div class="wrap grid"><h2 class="label s-4">{a.priceTitle}</h2><p class="s-8 price">{a.price}</p></div></section>
  <section><div class="wrap grid"><h2 class="label s-4">{a.stepsTitle}</h2><ol class="s-8 list">{a.steps.map((s) => <li>{s}</li>)}</ol></div></section>
  <section><div class="wrap grid"><h2 class="label s-4">{a.faqTitle}</h2><dl class="s-8 faq">{a.faq.map((f) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}</dl></div></section>
</Page>
<style>
  .head { padding-top: 56px; padding-bottom: 48px; }
  .head p { margin-top: 16px; }
  .reg { color: var(--ink); }
  .list { margin: 0; padding-left: 1.2em; }
  .list li { margin-bottom: 0.6em; }
  .price { color: var(--celadon); }
  .faq dt { font-weight: 500; margin-top: 18px; }
  .faq dd { margin: 6px 0 0; color: var(--muted); }
</style>
