---
import Page from '../../shared/layouts/Page.astro';
import { HQ } from '../../shared/site';
import { t } from '../copy';
const p = t.privacy;
---
<Page title={p.title} description={p.description} path="/privacy/" alt="/privacy/">
  <div class="wrap msg"><h1 class="display h1">{p.h1}</h1><p>{p.body}</p><p class="muted">{HQ.name}，{t.footer.uscc} {HQ.uscc}</p></div>
</Page>
<style>.msg { padding: 56px var(--pad) 96px; } .msg h1 { margin-bottom: 24px; }</style>
