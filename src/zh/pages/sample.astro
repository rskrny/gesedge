---
import Page from '../../shared/layouts/Page.astro';
import { t } from '../copy';
const s = t.sample;
---
<Page title={s.title} description={s.description} path="/sample/">
  <div class="wrap head"><h1 class="display h1">{s.h1}</h1><p class="muted">{s.body}</p></div>
</Page>
<style>.head { padding-top: 56px; padding-bottom: 96px; } .head p { margin-top: 16px; }</style>
