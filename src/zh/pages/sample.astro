---
import Page from '../../shared/layouts/Page.astro';
import { t } from '../copy';
import { SAMPLE_READY } from '../../shared/site';
const s = t.sample;
---
<Page title={s.title} description={s.description} path="/sample/" noindex={!SAMPLE_READY}>
  <div class="wrap page-head"><h1 class="display h1">{s.h1}</h1><p class="lede">{s.body}</p></div>
</Page>

