---
// All text from ../../copy.ts. WeCom: Kenny's 联系我 QR (desktop) and 获客链接 (phone/WeChat) go here once registered.
// The consent box is unticked and required (PIPL cross-border transfer); notice text from Kenny + review.
import Page from '../../../shared/layouts/Page.astro';
import { t } from '../../copy';
const c = t.contact;
---
<Page title={c.title} description={c.description} path="/contact/">
  <div class="wrap page-head"><h1 class="display h1">{c.h1}</h1></div>
  <section>
    <div class="wrap grid">
      <div class="s-4 wecom">
        <p>{c.wecom}</p>
        <div class="qr">{c.wecomPending}</div>
      </div>
      <form class="s-8 form" method="post" action="/api/contact/">
        <h2 class="label">{c.formTitle}</h2>
        <label>{c.fields.name} <input name="name" required maxlength="100" /></label>
        <label>{c.fields.company} <input name="company" maxlength="200" /></label>
        <label>{c.fields.wechat} <input name="contact" required maxlength="100" /></label>
        <label>{c.fields.site} <input name="site" maxlength="300" /></label>
        <label>{c.fields.need} <textarea name="message" required maxlength="4000" rows="5"></textarea></label>
        <label class="hp" aria-hidden="true">x <input name="website2" tabindex="-1" autocomplete="off" /></label>
        <label class="check"><input type="checkbox" name="consent" value="yes" required /> <span>{c.consent}<a href="/privacy/">{t.footer.privacy}</a>。</span></label>
        <button class="btn" type="submit">{c.send}</button>
      </form>
    </div>
  </section>
</Page>
<style>
  .qr { width: 200px; height: 200px; border: 1px dashed var(--line); display: grid; place-content: center; text-align: center; padding: 12px; color: var(--muted); font-size: 13px; margin-top: 16px; }
  .form { display: grid; gap: 16px; max-width: 640px; }
  .form label { display: grid; gap: 6px; font-size: 15px; }
  .form input:not([type='checkbox']), .form textarea { font: 400 17px/1.5 var(--sans); color: var(--ink); background: var(--panel); border: 1px solid var(--line); border-radius: 2px; padding: 12px 14px; }
  .form .check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--muted); }
  .form .check { min-height: 44px; } .form .check input { margin-top: 3px; width: 20px; height: 20px; flex: none; }
  .form button { justify-self: start; cursor: pointer; }
  .hp { position: absolute; left: -9999px; }
</style>
