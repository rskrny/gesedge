---
// All text from ../copy.ts (Kenny's file). Hero object: the joint (燕尾榫) until the sample audit exists,
// then a page from it goes in a proof band under the hero, as on the English home page.
import Page from '../../shared/layouts/Page.astro';
import Joint from '../../shared/components/Joint.astro';
import { CANONICAL, HQ, EMAIL } from '../../shared/site';
import { t } from '../copy';
const h = t.home;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: HQ.name,
  alternateName: HQ.latin,
  url: CANONICAL.zh,
  logo: CANONICAL.zh + '/share.png',
  email: EMAIL,
  taxID: HQ.uscc,
  founder: { '@type': 'Person', name: 'Ryan Kearney' },
  address: { '@type': 'PostalAddress', streetAddress: HQ.address, addressLocality: '成都', addressCountry: 'CN' },
};
---
<Page title={h.title} description={h.description} path="/" alt="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(org)} />
  <div class="hero">
    <div class="wrap stage">
      <div class="lead">
        <h1 class="display h1">{h.h1}</h1>
        <p class="lede">{h.lede}</p>
        <p class="ctas"><a class="btn" href="/contact/">{h.cta}</a> <a class="btn ghost" href="/sample/">{h.cta2}</a></p>
      </div>
      <div class="obj"><Joint /></div>
    </div>
  </div>
  <section><div class="wrap doc"><h2 class="h3 sec-title">{h.problemTitle}</h2><p>{h.problemBody}</p></div></section>
  <section class="band"><div class="wrap doc"><h2 class="h3 sec-title">{h.auditTitle}</h2><div><p class="price">{h.auditBody}</p><p><a href="/audit/">{t.nav.audit} →</a></p></div></div></section>
  <section><div class="wrap doc"><h2 class="h3 sec-title">{h.afterTitle}</h2><ol class="rows">{h.after.map((a, i) => <li>{a}</li>)}</ol></div></section>
  <section><div class="wrap doc"><h2 class="h3 sec-title">{h.whoTitle}</h2><p>{h.whoBody}</p></div></section>
</Page>
<style>
  .price { font: 400 18px/1.6 var(--sans); border-left: 2px solid var(--celadon); padding-left: 16px; }
</style>
