---
// All text from ../copy.ts (Kenny's file). Hero object: a page from the sample audit, once it exists.
import Page from '../../shared/layouts/Page.astro';
import Logo from '../../shared/components/Logo.astro';
import { COORDS, CANONICAL, HQ, EMAIL } from '../../shared/site';
import { t } from '../copy';
const h = t.home;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: HQ.name,
  alternateName: HQ.latin,
  url: CANONICAL.zh,
  logo: CANONICAL.zh + '/share.png',
  email: EMAIL,
  taxID: HQ.uscc,
  founder: { '@type': 'Person', name: 'Ryan Kearney' },
  address: { '@type': 'PostalAddress', streetAddress: HQ.address, addressLocality: '成都', addressCountry: 'CN' },
};
---
<Page title={h.title} description={h.description} path="/" alt="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(org)} />
  <div class="hero wrap">
    <div class="corners label" aria-hidden="true"><span>{COORDS}</span><span>Chengdu</span></div>
    <div class="grid">
      <div class="s-7">
        <h1 class="display h1">{h.h1}</h1>
        <p class="sub">{h.lede}</p>
        <p class="ctas"><a class="btn" href="/contact/">{h.cta}</a> <a class="btn ghost" href="/sample/">{h.cta2}</a></p>
      </div>
      <div class="s-5 fig ph-box"><Logo variant="chengdu" height={64} /><p class="label">[PLACEHOLDER: page from the sample audit]</p></div>
    </div>
  </div>
  <section><div class="wrap grid"><h2 class="label s-4">{h.problemTitle}</h2><p class="s-8">{h.problemBody}</p></div></section>
  <section><div class="wrap grid"><h2 class="label s-4">{h.auditTitle}</h2><div class="s-8"><p class="price">{h.auditBody}</p><p><a href="/audit/">{t.nav.audit} →</a></p></div></div></section>
  <section><div class="wrap grid"><h2 class="label s-4">{h.afterTitle}</h2><ol class="s-8 rows">{h.after.map((a, i) => <li><span class="ord">{String(i + 1).padStart(2, '0')}</span> {a}</li>)}</ol></div></section>
  <section><div class="wrap grid"><h2 class="label s-4">{h.whoTitle}</h2><p class="s-8">{h.whoBody}</p></div></section>
</Page>
<style>
  .hero { padding-top: 56px; padding-bottom: 56px; }
  .corners { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .sub { margin-top: 24px; color: var(--muted); }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .ph-box { border: 1px dashed var(--line); min-height: 280px; display: grid; place-content: center; gap: 16px; justify-items: center; padding: 24px; }
  .price { color: var(--celadon); }
  .rows li { display: flex; gap: 16px; align-items: baseline; }
</style>
