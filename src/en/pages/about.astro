---
// Copy: .ai/deliverables/redo-copy-en.md (v3, gated). Everglory + C14 lines approved by Ryan 2026-10-07.
// 2026-10-08 anti-AI pass: bios rewritten as prose, "Two companies, one founder" and the coordinates line removed.
// ponytail: no photo yet. Ryan's headshot (private copy in ../business/redo-assets-private/headshots) goes
// here as a compressed AVIF/WebP once he picks one.
import Page from '../../shared/layouts/Page.astro';
import { GES, HQ } from '../../shared/site';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ryan Kearney',
  jobTitle: 'Founder',
  worksFor: { '@type': 'Organization', name: GES.name },
  homeLocation: { '@type': 'Place', name: 'Chengdu, China' },
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Massachusetts Maritime Academy' }, { '@type': 'CollegeOrUniversity', name: 'Sichuan University' }],
};
---
<Page
  title="About · Global Edge Strategies"
  description="Ryan Kearney, an American in Chengdu, runs Global Edge Strategies and its sister company 成都寰桥."
  path="/about/"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <div class="wrap page-head"><h1 class="display h1">About</h1></div>

  <section>
    <div class="wrap people">
      <div class="ryan">
        <h2 class="h3">Ryan Kearney</h2>
        <p class="bio">Ryan is an American who lives in Chengdu. After a B.S. at Massachusetts Maritime Academy, he coordinated import operations at Everglory Logistics, a freight forwarder and customs broker in Boston, from 2021 to 2022. He has an MBA from Sichuan University. He started Global Edge Strategies in 2024 and builds its systems himself, and he is CTO of C14 Space, the UK company that makes ShopMyRoom.</p>
      </div>
      <div class="kenny">
        <h2 class="h3">Zhu Shiying (Kenny)</h2>
        <p class="bio">Kenny is a developer in Chengdu. He works on new builds and with clients who speak Chinese.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap doc">
      <h2 class="display h2 sec-title">The companies</h2>
      <p><strong>{GES.name}</strong>, registered in Wyoming, builds AI systems for US businesses and advises those that buy from Chinese suppliers.</p>
      <p>Its sister company in Chengdu is <strong lang="zh-CN">{HQ.name}</strong> ({HQ.latin}). It reviews factory websites from a US buyer’s point of view and builds English websites for Chinese factories.</p>
    </div>
  </section>
</Page>

<style>
  .people { display: grid; grid-template-columns: 7fr 5fr; gap: 40px 72px; align-items: start; }
  .people h2 { margin-bottom: 14px; }
  .bio { font-size: clamp(1.1rem, 1.6vw, 1.3rem); line-height: 1.55; }
  .doc strong { font-weight: 600; }
  @media (max-width: 860px) { .people { grid-template-columns: 1fr; } }
</style>
