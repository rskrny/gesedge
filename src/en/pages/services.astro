---
// Copy: .ai/deliverables/redo-copy-en.md (v3, gated) + 2026-10-08 anti-AI pass (fragments rewritten, gate re-run).
// Layout: a price list. Title and headline price on one line, details in two columns. No ordinals, no labels.
import Page from '../../shared/layouts/Page.astro';
import { BOOKING, CANONICAL } from '../../shared/site';
import { service, faqPage, graph } from '../../shared/schema';
import Snapshot from '../components/Snapshot.astro';

const faq = [
  { q: 'Do you work with companies outside the US?', a: 'These services are for US companies. Companies in China work with our sister company, <span lang="zh-CN">成都寰桥</span>, which offers the same kind of systems and bills in RMB. See <a href="/china/">For companies in China</a>.' },
  { q: 'Where does my data go?', a: 'Before a build starts, the contract says where the system runs, who can access it, how it is backed up, and how it is handed over if you stop working with us.' },
  { q: 'Who builds the systems?', a: 'Ryan Kearney, with Zhu Shiying on new builds.' },
  { q: 'Which AI models do you use?', a: 'We choose the model during the review, based on the task and on where your data is allowed to go. Model and hosting costs are billed at cost.' },
  { q: 'How do I pay?', a: 'By invoice, in US dollars. Builds are half upfront. Supplier checks and visits in China are paid in advance.' },
  { q: 'What if the review shows a build won’t pay off?', a: 'We tell you, and you keep the plan.' },
];
---
<Page
  title="Services and prices · Global Edge Strategies"
  description="AI systems for US importers and distributors buying from Asia, China supplier support, dashboards and company websites. Prices and support scope."
  path="/services/"
>
  <script slot="head" type="application/ld+json" set:html={graph(
    service({ name: 'AI operations pilot', url: CANONICAL.en + '/services/#ai-operations', provider: 'ges', area: 'US', offers: [
      { name: 'Workflow review', currency: 'USD', price: 2500 },
      { name: 'Build', currency: 'USD', minPrice: 15000 },
      { name: 'Monitoring', currency: 'USD', price: 750, perMonth: true },
      { name: 'Monitoring and improvements', currency: 'USD', price: 1500, perMonth: true },
    ] }),
    service({ name: 'Owner’s dashboard', url: CANONICAL.en + '/services/#dashboards', provider: 'ges', area: 'US', offers: [
      { name: 'Setup', currency: 'USD', minPrice: 3000 },
      { name: 'Reports and monitoring', currency: 'USD', minPrice: 750, perMonth: true },
    ] }),
    service({ name: 'Your person in China', url: CANONICAL.en + '/services/#china', provider: 'ges', area: 'US', offers: [
      { name: 'Desk check', currency: 'USD', price: 750 },
      { name: 'Supplier visit', currency: 'USD', price: 1500 },
      { name: 'Other regions', currency: 'USD', minPrice: 2500 },
      { name: 'Retainer', currency: 'USD', minPrice: 1500, perMonth: true },
    ] }),
    service({ name: 'Company website', url: CANONICAL.en + '/services/#websites', provider: 'ges', area: 'US' }),
    faqPage(faq),
  )} />
  <div class="wrap page-head">
    <h1 class="display h1">Services and prices</h1>
    <p class="lede">These services are for US importers and distributors buying from Asia, with teams of about 10 to 100 people. Start with email, order entry or shipment status, or get help checking a Chinese supplier. We agree the scope and price before work starts. Prices are in US dollars.</p>
  </div>

  <section id="ai-operations">
    <div class="wrap">
      <header class="svc-head"><h2 class="display h2">AI operations pilot</h2><p class="price">Review $2,500<span>Builds from $15,000</span></p></header>
      <div class="svc-body">
        <div>
          <h3 class="label">Who it’s for</h3>
          <p>Import and distribution teams that spend hours a day on customer email, order entry or shipment updates. The review measures the work and tells you whether a build is worth the cost.</p>
          <h3 class="label">Timeline</h3>
          <p>The email triage system went from approved scope to production in about 12 weeks. Your review sets the schedule for your build.</p>
        </div>
        <div>
          <h3 class="label">What you get</h3>
          <ul>
            <li><strong>Workflow review.</strong> We map one workflow and measure it, then give you a written plan and a fixed build price.</li>
            <li><strong>Build.</strong> One system for that workflow, with automated tests that run before every change.</li>
            <li><strong>Shadow mode.</strong> The system runs beside your team until its output has been checked.</li>
          </ul>
          <h3 class="label">Price</h3>
          <p>Review $2,500, credited to the build if you go ahead. Builds from $15,000, half upfront. Support is $750 a month for monitoring or $1,500 a month with a limited improvement allowance. <a href="#support">See support terms</a>.</p>
          <p><a href="/work/#email-triage">Example: email triage for a refurbishment group →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="dashboards">
    <div class="wrap">
      <header class="svc-head"><h2 class="display h2">Owner’s dashboard</h2><p class="price">Setup from $3,000<span>then from $750 a month</span></p></header>
      <div class="svc-body">
        <div>
          <h3 class="label">Who it’s for</h3>
          <p>Owners who check five different systems to find out how the week is going.</p>
        </div>
        <div>
          <h3 class="label">What you get</h3>
          <p>One private page behind a sign-in, rebuilt every night from the systems you already use.</p>
          <h3 class="label">Price</h3>
          <p>Setup from $3,000. Then $750 a month for reports and monitoring, or $1,500 a month with a monthly review and one improvement built (up to one working day). <a href="#support">See support terms</a>.</p>
          <p><a href="/work/#owner-dashboard">Example: dashboard for an auction firm →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="china">
    <div class="wrap">
      <header class="svc-head"><h2 class="display h2">Your person in China</h2><p class="price">Desk check $750<span>Supplier visit $1,500</span></p></header>
      <div class="svc-body">
        <div>
          <h3 class="label">Who it’s for</h3>
          <p>US companies that buy from Chinese suppliers and need someone on the ground in China.</p>
          <h3 class="label">What we don’t do</h3>
          <p>We don’t handle goods, payments, or shipping. For first orders under about $25,000, we’ll point you to a third-party inspection firm instead. We never check a supplier that our sister company <span lang="zh-CN">成都寰桥</span> works for, and we tell you if we have worked with a supplier you ask about.</p>
        </div>
        <div>
          <h3 class="label">What you get</h3>
          <ul>
            <li><strong>Desk check, $750.</strong> We look up a supplier’s business registration, lawsuits and penalties on public record, US shipment records, and whether the certificates it claims appear in the issuers’ public databases. You get a written report that says what we found and whether it looks like a factory or a trading company.</li>
            <li><strong>Supplier visit, $1,500.</strong> Ryan visits one supplier in the Chengdu–Chongqing area and writes a memo in English to help you decide.</li>
            <li><strong>Other regions,</strong> from $2,500 plus travel.</li>
            <li><strong>Retainer,</strong> from $1,500 a month with a three-month minimum. Includes up to six hours a month of desk research, email questions and scheduled calls covering up to two suppliers in China. Visits are quoted separately, starting at $1,500 per supplier in Chengdu–Chongqing or $2,500 elsewhere, plus travel.</li>
          </ul>
          <p class="meta">We acknowledge questions within one business day during the support hours below. Unused hours expire each month. Additional suppliers or hours need a separate quote and your approval.</p>
          <p class="meta">Travel and other third-party costs are billed at cost.</p>
        </div>
      </div>
      <Snapshot variant="services" />
    </div>
  </section>

  <section id="websites">
    <div class="wrap">
      <header class="svc-head"><h2 class="display h2">Company website</h2><p class="price">Fixed quote<span>after a 30-minute call</span></p></header>
      <div class="svc-body">
        <div>
          <h3 class="label">Who it’s for</h3>
          <p>An importer or distributor whose website needs to explain its products and turn a buyer’s questions into an inquiry.</p>
          <h3 class="label">How it runs</h3>
          <p>We use the call to agree the pages, content and inquiry process, then send a fixed quote and schedule. You review the site on a preview link before launch.</p>
        </div>
        <div>
          <h3 class="label">Starting scope</h3>
          <p>A five-to-eight-page English website that works on phones, with product or service pages and an inquiry form. We write the copy from the material you provide, connect your domain and hand over the source code.</p>
          <h3 class="label">What changes the quote</h3>
          <p>Online payments, stock feeds, customer accounts, additional languages and new photography are quoted separately. Hosting, domain renewal and paid services are separate costs. Ongoing support is agreed in the quote.</p>
          <p><a class="btn" href={BOOKING}>Discuss a website</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="support">
    <div class="wrap">
      <h2 class="display h2 sec-title">Monthly support terms</h2>
      <p>These limits cover the AI pilot and dashboard plans. The signed quote confirms the system, data sources and reports covered.</p>
      <div class="svc-body">
        <div>
          <h3 class="label">Monitoring, $750 a month</h3>
          <p>We check failed jobs and error logs each business day, send a monthly summary and include up to two hours a month to investigate and fix faults in the agreed system. For dashboards, this covers the agreed scheduled reports.</p>
          <h3 class="label">Monitoring and improvements, $1,500 a month</h3>
          <p>Everything in monitoring, plus a monthly review and one agreed improvement taking up to one working day (eight hours). Repair and improvement allowances expire each month.</p>
        </div>
        <div>
          <h3 class="label">Hours and response</h3>
          <p>Support hours are 9am to 6pm China Standard Time, Monday to Friday, excluding public holidays in China. We acknowledge requests within one business day during those hours and agree the next action. Resolution time depends on the fault.</p>
          <h3 class="label">When a run or data source fails</h3>
          <p>We notify you by email and investigate during support hours. New data sources, changes to a provider’s interface and work beyond the included hours need a separate quote and your approval. Hosting, model usage and other provider fees are billed at cost.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap doc">
      <h2 class="display h2 sec-title">Questions</h2>
      <dl class="faq">
        {faq.map((f) => (<><dt>{f.q}</dt><dd set:html={f.a} /></>))}
      </dl>
    </div>
  </section>

  <section class="band close">
    <div class="wrap grid">
      <h2 class="display h2 s-6">Start with a 30‑minute call</h2>
      <p class="s-6"><a class="btn" href={BOOKING}>Book a call</a></p>
    </div>
  </section>
</Page>

<style>
  .svc-head { display: flex; justify-content: space-between; align-items: baseline; gap: 24px 48px; flex-wrap: wrap;
    padding-bottom: 28px; margin-bottom: 36px; border-bottom: 1px solid var(--line); }
  .svc-head .price { text-align: right; font-size: 18px; margin: 0; }
  .svc-body { display: grid; grid-template-columns: 5fr 7fr; gap: 24px 64px; }
  .svc-body h3 { margin: 28px 0 8px; }
  .svc-body > div > h3:first-child { margin-top: 0; }
  .svc-body ul { padding-left: 1.1em; margin: 0 0 1em; }
  .svc-body li { margin-bottom: 0.6em; }
  .svc-body strong { font-weight: 600; color: var(--ink); }
  .faq { margin: 0; }
  .faq dt { font-weight: 600; margin-top: 28px; }
  .faq dt:first-child { margin-top: 0; }
  .faq dd { margin: 6px 0 0; color: var(--muted); }
  @media (max-width: 860px) {
    .svc-body { grid-template-columns: 1fr; }
    .svc-head .price { text-align: left; }
  }
</style>
