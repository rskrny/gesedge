---
// Copy: .ai/deliverables/redo-copy-en.md (v3, gated) + the 2026-10-08 anti-AI pass (no-ai-slop gate re-run).
// Don't edit wording here without re-running the gate. Layout: DESIGN.md §5–6 (no labels, no ordinals, no HUD).
// 2026-10-14 repositioning (DECISIONS.md): H1 about operations systems only; "Your person in China" moved to /services/;
// China-side systems on /china/. EN home is not paired with the ZH home (different buyers).
import Page from '../../shared/layouts/Page.astro';
import Joint from '../../shared/components/Joint.astro';
import { BOOKING, EMAIL, CANONICAL, GES } from '../../shared/site';
import { work, builtFor } from '../work';

const offers = [
  { name: 'AI operations pilot', body: 'We start with a paid review of one workflow, build one system for it, and run that system beside your team until its output has been checked.', price: ['Review $2,500, credited to the build', 'Builds from $15,000'] },
  { name: 'Owner’s dashboard', body: 'One private page that shows what is happening across your business, rebuilt every night from the systems you already use.', price: ['Setup from $3,000', 'then from $750 a month'] },
];
const steps = [
  { name: 'Review', body: 'We review one workflow for a fee and give you a written plan and a fixed price.' },
  { name: 'Build', body: 'We build one system for that workflow, with tests that run before every change.' },
  { name: 'Shadow mode', body: 'The system runs beside your team, and its output is checked before anyone relies on it.' },
  { name: 'Support', body: 'Support costs $750 a month for monitoring, or $1,500 a month with improvements.' },
];
const [lead, ...rest] = work;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: GES.name,
  url: CANONICAL.en,
  email: EMAIL,
  logo: CANONICAL.en + '/share.png',
  founder: { '@type': 'Person', name: 'Ryan Kearney' },
  address: { '@type': 'PostalAddress', addressRegion: 'WY', addressCountry: 'US' },
};
---
<Page
  title="Global Edge Strategies · AI systems for operations teams"
  description="We build AI systems for teams that spend hours a day on email, order entry and status updates. Run by Ryan Kearney from Chengdu."
  path="/"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(org)} />

  <div class="hero">
    <div class="wrap stage">
      <div class="lead">
        <h1 class="display h1">We build AI systems for teams that spend hours a day sorting email.</h1>
        <p class="lede">Ryan Kearney built every system on this site. Three of them run every day for US clients.</p>
        <p class="ctas"><a class="btn" href={BOOKING}>Book a call</a> <a class="text-link" href="/work/">See the work →</a></p>
        <p class="aside"><a href="/china/">For companies in China →</a></p>
      </div>
      <div class="obj"><Joint /></div>
    </div>
  </div>

  <section class="band proof" aria-labelledby="proof-title">
    <div class="wrap proof-grid">
      <div class="proof-copy">
        <h2 class="display h2" id="proof-title">{lead.title}</h2>
        <p class="meta">{builtFor(lead)}</p>
        <p class="muted">{lead.home}</p>
        <p><a href={`/work/#${lead.id}`}>More on the work →</a></p>
      </div>
      <figure class="shot">
        <img src={lead.image.src} alt={lead.image.alt} width={lead.image.w} height={lead.image.h} fetchpriority="high" />
        <figcaption class="meta">On the executive dashboard, each ticket shows as on track, at risk, or overdue against its target date. The system sorts mail into 29 categories.</figcaption>
      </figure>
    </div>
    <ul class="wrap also">
      {rest.map((w) => (
        <li><h3 class="h3">{w.title}</h3><p class="meta">{builtFor(w)}</p><p class="muted">{w.home}</p></li>
      ))}
    </ul>
  </section>

  <section id="services">
    <div class="wrap">
      <h2 class="display h2 sec-title">Each service has a fixed price, agreed before work starts.</h2>
      <ul class="ledger">
        {offers.map((o) => (
          <li>
            <h3 class="h3">{o.name}</h3>
            <p>{o.body}</p>
            <p class="price">{o.price[0]}<span>{o.price[1]}</span></p>
          </li>
        ))}
      </ul>
      <p class="after"><a href="/services/">All services and prices →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="display h2 sec-title">How a project runs</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><p class="step">{i + 1}</p><h3 class="h3">{s.name}</h3><p class="muted">{s.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="display h2 sec-title">Who builds it</h2>
      <p class="big">Ryan Kearney is an American who lives in Chengdu. He coordinated import operations at a freight forwarder in Boston before he started building software. Zhu Shiying, a developer in Chengdu, works on new builds and with Chinese-speaking clients.</p>
      <p><a href="/about/">About →</a></p>
    </div>
  </section>

  <section class="band close">
    <div class="wrap grid">
      <h2 class="display h1 s-6">Start with a 30‑minute call</h2>
      <div class="s-6">
        <p class="lede">We talk on video about your workflow and whether a review makes sense. The booking page shows times in your timezone. You can also email <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
        <p><a class="btn" href={BOOKING}>Book a call</a></p>
      </div>
    </div>
  </section>
</Page>

<style>
  .text-link { align-self: center; color: var(--ink); text-decoration: none; font-size: 15px; padding: 0 6px; }
  .text-link:hover { color: var(--celadon); }

  .after { margin: 32px 0 0; }
  .big { font-size: clamp(1.15rem, 1.8vw, 1.5rem); line-height: 1.5; max-width: 34em; }
  .close .btn { margin-top: 8px; }
</style>
