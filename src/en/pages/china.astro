const examples = [
  { name: 'Shared inbox and inquiries', body: 'Mail to a shared or sales mailbox can become a ticket with an owner and a deadline, with late tickets flagged. Our <a href="/work/#email-triage">email triage system</a> works this way.' },
  { name: 'Quotes', body: 'Quote emails can be drafted from your rate sheets, surcharges, validity dates and laycan, then sent to agents or customers once a person approves them. Every quote stays on record.' },
  { name: 'Bookings and space', body: 'Space, bookings and confirmations can live in one place instead of spreadsheets and email threads, with a log of every change and a warning when two bookings clash.' },
  { name: 'Document drafts', body: 'The system can draft bills of lading, invoices and packing lists from the booking data and check the required fields. Your operations staff review and issue them. The system never issues a document.' },
];
const steps = [
  { name: 'Workflow review, ¥9,800', body: 'We walk through one workflow and give you a written plan and a fixed price. The fee is credited in full if you go ahead. If a build won’t pay off, we tell you, and you keep the plan.' },
  { name: 'Build, from ¥60,000', body: 'The price is fixed. The contract sets out the scope and the acceptance tests, and you pay in stages. If the scope changes, we agree the new price first.' },
  { name: 'Parallel run', body: 'The system runs beside your team for the period set in the contract, and its output is checked against agreed test cases. New requirements are priced separately.' },
  { name: 'Maintenance, 15% of the build price a year', body: 'The contract states response times and what maintenance covers.' },
