---
// Copy: .ai/deliverables/redo-copy-en.md (v3, gated) + 2026-10-08 anti-AI pass. Data: ../work.ts.
// Screenshots: email triage + dashboard made by ../business/redo-assets-private/redact.py (no client data readable);
// booking system = the charter's public booking page (no customer data), captured 2026-10-08 with Ryan's OK.
// Layout: case studies. Title + one plain line, full-width screen, then the story in columns. No ordinals or labels.
import Page from '../../shared/layouts/Page.astro';
import { BOOKING } from '../../shared/site';
import { work, builtFor } from '../work';
---
<Page
  title="Work · Global Edge Strategies"
  description="Three live systems: email triage for a refurbishment group, an owner's dashboard for an auction firm, and a booking system for a charter boat."
  path="/work/"
>
  <div class="wrap page-head">
    <h1 class="display h1">Work</h1>
    <p class="lede">These three systems are live. Client names stay off this page until each client agrees.</p>
  </div>

  {work.map((w) => (
    <section id={w.id}>
      <div class="wrap">
        <header class="case-head">
          <h2 class="display h2">{w.title}</h2>
          <p class="meta">{builtFor(w)}</p>
        </header>
        <figure class="shot">
          <img src={w.image.src} alt={w.image.alt} width={w.image.w} height={w.image.h} loading="lazy" decoding="async" />
        </figure>
        <div class={`case-body ${w.before ? 'three' : 'two'}`}>
          {w.before && <div><h3 class="label">Before</h3><p>{w.before}</p></div>}
          <div><h3 class="label">What we built</h3><p>{w.built}</p></div>
          <div><h3 class="label">What happened</h3><p>{w.result}</p></div>
        </div>
      </div>
    </section>
  ))}

  <section class="band close">
    <div class="wrap grid">
      <h2 class="display h2 s-6">Start with a 30‑minute call</h2>
      <p class="s-6"><a class="btn" href={BOOKING}>Book a call</a></p>
    </div>
  </section>
</Page>

<style>
  .case-head { margin-bottom: 32px; }
  .case-head .meta { margin: 10px 0 0; }
  .shot { margin: 0 0 48px; }
  .shot img { width: 100%; height: auto; border-radius: 6px; box-shadow: 0 0 0 1px var(--line); }
  .case-body { display: grid; gap: 24px 48px; }
  .case-body.three { grid-template-columns: repeat(3, 1fr); }
  .case-body.two { grid-template-columns: 1fr 1fr; }
  .case-body h3 { margin: 0 0 10px; }
  .case-body p { font-size: 17px; }
  @media (max-width: 860px) {
    .case-body.three, .case-body.two { grid-template-columns: 1fr; }
  }
</style>
