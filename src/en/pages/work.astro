---
// Copy: .ai/deliverables/redo-copy-en.md (v3, gated). Data: ../work.ts.
// Screenshots: made by ../business/redo-assets-private/redact.py (outside the repo); no client data readable.
// The booking system has no screenshot: its public site would identify the client.
import Page from '../../shared/layouts/Page.astro';
import { BOOKING } from '../../shared/site';
import { work } from '../work';
---
<Page
  title="Work · Global Edge Strategies"
  description="Three live systems: email triage for a refurbishment group, an owner's dashboard for an auction firm, and a booking system for a charter boat."
  path="/work/"
>
  <div class="wrap page-head">
    <p class="label">Systems in use</p>
    <h1 class="display h1">Work</h1>
    <p class="lede">Three live systems. Client names stay off this page until each client agrees.</p>
  </div>

  {work.map((w, i) => (
    <section id={w.id}>
      <div class="wrap grid">
        <div class="s-4 side">
          <span class="ord">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="display h2">{w.title}</h2>
          <p class="label meta">{w.meta}</p>
        </div>
        <div class="s-8 body">
          {w.image && (
            <figure class="shot">
              <img src={w.image.src} alt={w.image.alt} width="1600" height="887" loading="lazy" decoding="async" />
              <figcaption class="label">Real screen · client data blurred</figcaption>
            </figure>
          )}
          {w.before && <><h3 class="label">Before</h3><p>{w.before}</p></>}
          <h3 class="label">What we built</h3>
          <p>{w.built}</p>
          <h3 class="label">What happened</h3>
          <p>{w.result}</p>
        </div>
      </div>
    </section>
  ))}

  <section class="band close">
    <div class="wrap grid">
      <h2 class="display h2 s-4">Book a call</h2>
      <p class="s-8 ctas"><a class="btn" href={BOOKING}>Book a call</a> <a class="btn ghost" href="/services/">Services and prices</a></p>
    </div>
  </section>
</Page>

<style>
  .ord { display: block; margin-bottom: 20px; }
  .meta { margin-top: 16px; line-height: 1.7; }
  .body h3 { margin: 32px 0 10px; }
  .body h3:first-child { margin-top: 0; }
  .shot { margin: 0 0 40px; }
  .shot img { width: 100%; height: auto; border-radius: 6px; box-shadow: 0 0 0 1px var(--line); }
  .shot figcaption { margin-top: 14px; }
</style>
