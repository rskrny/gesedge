---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-lockup">
      <span class="footer-latin">GES</span>
      <span class="footer-divider" aria-hidden="true"></span>
      <span class="footer-cjk" lang="zh-Hans">成都寰桥</span>
    </div>
    <p class="footer-line">
      Global Edge Strategies LLC (Wyoming) · Chengdu Huanqiao (WFOE)
    </p>
    <p class="footer-line footer-dim">
      US ↔ China · <a href="mailto:ryan@gesedge.com">ryan@gesedge.com</a> · © {year}
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-5) var(--space-4);
    background: var(--ink-deep);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .footer-latin {
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--stroke);
  }

  .footer-divider {
    width: 1px;
    height: 0.78em;
    background: var(--stroke);
    opacity: 0.35;
  }

  .footer-cjk {
    font-family: var(--font-cjk);
    font-weight: 500;
    font-size: 0.84em;
    letter-spacing: 0; /* CJK never tracks like latin caps */
    color: var(--text);
    transform: translateY(-0.5px);
  }

  .footer-line {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }

  .footer-dim {
    color: var(--text-faint);
  }

  .footer-line a:hover {
    color: var(--text);
  }
</style>
