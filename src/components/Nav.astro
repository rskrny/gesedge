---
/* Fixed header. Lockup follows the bilingual recipe:
   ZH ≈ 0.8em of the Latin, one weight lighter, optically centered,
   hairline divider at Latin cap height. */
---

<header class="nav" data-header>
  <a href="/" class="lockup" aria-label="Global Edge Strategies home">
    <span class="lockup-latin">GES</span>
    <span class="lockup-divider" aria-hidden="true"></span>
    <span class="lockup-cjk" lang="zh-Hans">成都寰桥</span>
  </a>
  <nav class="nav-links" aria-label="Primary">
    <a href="#projects">Work</a>
    <a href="#services">Services</a>
    <a href="#about">About</a>
    <a href="#contact" class="nav-cta">Start a project</a>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem var(--page-pad);
    transition: background 0.4s var(--ease-out), backdrop-filter 0.4s var(--ease-out);
  }

  .nav.is-scrolled {
    background: rgba(8, 8, 12, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hairline);
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    line-height: 1;
  }

  .lockup-latin {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    color: var(--stroke);
  }

  .lockup-divider {
    width: 1px;
    height: 0.78em;
    background: var(--stroke);
    opacity: 0.35;
  }

  .lockup-cjk {
    font-family: var(--font-cjk);
    font-weight: 500;
    font-size: 0.84rem;
    letter-spacing: 0; /* CJK never tracks like latin caps */
    color: var(--text);
    transform: translateY(-0.5px);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.2rem);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav-links a {
    color: var(--text-dim);
    transition: color 0.25s;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-cta {
    padding: 0.55em 1.1em;
    border: 1px solid var(--warm-dim);
    border-radius: 999px;
    color: var(--text) !important;
    background: rgba(240, 200, 150, 0.05);
    transition: border-color 0.25s, background 0.25s;
  }

  .nav-cta:hover {
    border-color: var(--warm);
    background: rgba(240, 200, 150, 0.12);
  }

  @media (max-width: 640px) {
    .nav-links a:not(.nav-cta) {
      display: none;
    }
  }
</style>
